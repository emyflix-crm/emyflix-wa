generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
  PENDING
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  EXPIRED
  CANCELLED
  PENDING
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum InstanceStatus {
  CONNECTED
  DISCONNECTED
  CONNECTING
  ERROR
}

enum MediaType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum RecurrenceType {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ERROR
}

enum CampaignGroupStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum MessageStatus {
  SENT
  FAILED
  PENDING
}

model User {
  id                     String             @id @default(uuid()) @db.Uuid
  name                   String
  email                  String             @unique
  passwordHash           String
  role                   Role               @default(USER)
  emailVerified          Boolean            @default(false)
  emailVerificationToken String?
  emailVerificationExpires DateTime?
  passwordResetToken     String?
  passwordResetExpires   DateTime?
  trialEndsAt            DateTime?
  isTrialActive          Boolean            @default(false)
  status                 UserStatus         @default(PENDING)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  subscriptions          Subscription[]
  instances              WhatsAppInstance[]
  campaigns              Campaign[]
  history                MessageHistory[]
  dailyUsage             DailyUsage[]
  auditLogs              AuditLog[]
  refreshTokens          RefreshToken[]
}

model Plan {
  id                 String         @id @default(uuid()) @db.Uuid
  name               String
  slug               String         @unique
  description        String?
  price              Decimal        @db.Decimal(10, 2)
  maxMessagesPerDay  Int
  maxGroups          Int
  maxCampaigns       Int
  maxInstances       Int
  features           Json?
  isActive           Boolean        @default(true)
  sortOrder          Int            @default(0)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  subscriptions      Subscription[]
}

model Subscription {
  id             String             @id @default(uuid()) @db.Uuid
  userId         String             @db.Uuid
  planId         String             @db.Uuid
  status         SubscriptionStatus
  billingCycle   BillingCycle
  startsAt       DateTime
  endsAt         DateTime
  mercadoPagoId  String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan           Plan               @relation(fields: [planId], references: [id])
}

model WhatsAppInstance {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @db.Uuid
  instanceName String
  instanceKey  String         @unique
  apiEndpoint  String?
  status       InstanceStatus @default(DISCONNECTED)
  qrCode       String?        @db.Text
  lastSeenAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  groups       Group[]
  campaigns    Campaign[]
  history      MessageHistory[]
}

model Group {
  id               String           @id @default(uuid()) @db.Uuid
  instanceId       String           @db.Uuid
  groupJid         String           @unique
  name             String
  participantsCount Int             @default(0)
  isAvailable      Boolean          @default(true)
  lastSyncedAt     DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  instance         WhatsAppInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  campaignGroups   CampaignGroup[]
  history          MessageHistory[]
}

model Campaign {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @db.Uuid
  instanceId      String         @db.Uuid
  name            String
  message         String         @db.Text
  mediaUrl        String?
  mediaType       MediaType      @default(TEXT)
  recurrenceType  RecurrenceType
  recurrenceDays  Json?
  recurrenceDay   Int?
  timezone        String         @default("America/Sao_Paulo")
  scheduledAt     DateTime
  nextRunAt       DateTime?
  status          CampaignStatus @default(ACTIVE)
  intervalMinutes Int            @default(1)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  instance        WhatsAppInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  groups          CampaignGroup[]
  history         MessageHistory[]
}

model CampaignGroup {
  id           String              @id @default(uuid()) @db.Uuid
  campaignId   String              @db.Uuid
  groupId      String              @db.Uuid
  orderIndex   Int
  scheduledAt  DateTime
  status       CampaignGroupStatus @default(PENDING)
  sentAt       DateTime?
  errorMessage String?             @db.Text
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  campaign     Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  group        Group               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  history      MessageHistory[]
}

model MessageHistory {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @db.Uuid
  campaignId      String?        @db.Uuid
  campaignGroupId String?        @db.Uuid
  instanceId      String         @db.Uuid
  groupId         String?        @db.Uuid
  groupName       String?
  status          MessageStatus
  errorMessage    String?        @db.Text
  sentAt          DateTime?
  createdAt       DateTime       @default(now())

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign        Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignGroup   CampaignGroup?   @relation(fields: [campaignGroupId], references: [id], onDelete: SetNull)
  instance        WhatsAppInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  group           Group?           @relation(fields: [groupId], references: [id], onDelete: SetNull)
}

model DailyUsage {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  date          DateTime @db.Date
  messagesCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
